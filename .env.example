# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server: la usa /private-info/[file] para leer el bucket privado coa-pdfs. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=

# Formulario de contacto (/contact)
# Destino de las consultas. Si queda vacío se usa community@ankor-bio.com.
CONTACT_TO_EMAIL=community@ankor-bio.com
# Remitente verificado en Resend, ej. "Ankor Biosciences <no-reply@ankor-bio.com>".
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (opcional, todavía no activo)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
